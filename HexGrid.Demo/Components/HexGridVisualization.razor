<div class="hex-grid-container">
    <svg width="@Width" height="@Height" viewBox="0 0 @Width @Height" class="hex-grid-svg">
        <!-- Background -->
        <rect width="100%" height="100%" fill="#f5f5f5"/>
        
        @if (Grid != null && Grid.Grid != null)
        {
            @foreach (var hex in Grid.Grid)
            {

                var corners = Grid.Layout.PolygonCorners(hex);
                var points = string.Join(" ", corners.Select(c => $"{c.X},{c.Y}"));
                var center = Grid.Layout.HexToPixel(hex);
                @* var isHighlighted = HighlightedHex != null && hex.Q == HighlightedHex.Q && hex.R == HighlightedHex.R; *@
                var fillColor = GetHexFillColor(hex);
                
                <g class="hex-cell" @onclick="() => OnHexClick(hex)" style="cursor: pointer;">
                    <polygon points="@points" 
                                fill="@fillColor" 
                                stroke="@StrokeColor" 
                                stroke-width="2"
                                opacity="0.7"/>
                    
                    @if (ShowCoordinates)
                    {
                        <g>
                            <text x="@center.X" y="@(center.Y - 5)" text-anchor="middle" font-size="12" fill="#333">q:@hex.Q</text>
                            <text x="@center.X" y="@(center.Y + 10)" text-anchor="middle" font-size="12" fill="#333">r:@hex.R</text>
                        </g>
                    }
                </g>
            }
        }
    </svg>
    
    @if (HighlightedHex != null)
    {
        <div class="hex-info">
            <strong>Selected Hex:</strong> Q: @HighlightedHex.Q, R: @HighlightedHex.R, S: @HighlightedHex.ToCube().S
        </div>
    }
</div>

@code {
    [Parameter]
    public HexCoordinateGrid? Grid { get; set; }
    
    [Parameter]
    public int Width { get; set; } = 800;
    
    [Parameter]
    public int Height { get; set; } = 600;
    
    [Parameter]
    public bool ShowCoordinates { get; set; } = true;
    
    [Parameter]
    public string HexColor { get; set; } = "#2196F3";
    
    [Parameter]
    public string StrokeColor { get; set; } = "#1976D2";

    // New parameters for line drawing
    [Parameter]
    public bool LineDrawingMode { get; set; } = false;

    [Parameter]
    public AxialHexCoordinate? LineStartHex { get; set; }

    [Parameter]
    public AxialHexCoordinate? LineEndHex { get; set; }

    [Parameter]
    public ICollection<AxialHexCoordinate>? LinePathHexes { get; set; }

    [Parameter]
    public EventCallback<AxialHexCoordinate> OnHexSelected { get; set; }
    
    private AxialHexCoordinate? HighlightedHex { get; set; }
    
    private void OnHexClick(AxialHexCoordinate hex)
    {
        if (LineDrawingMode)
        {
            OnHexSelected.InvokeAsync(hex);
        }
        else
        {
            HighlightedHex = hex;
        }
        StateHasChanged();
    }

    private string GetHexFillColor(AxialHexCoordinate hex)
    {
        // Line drawing mode colors
        if (LineDrawingMode)
        {
            if (LineStartHex != null && hex.Q == LineStartHex.Q && hex.R == LineStartHex.R)
                return "#4CAF50"; // Green for start
            
            if (LineEndHex != null && hex.Q == LineEndHex.Q && hex.R == LineEndHex.R)
                return "#F44336"; // Red for end
            
            if (LinePathHexes != null && LinePathHexes.Any(p => p.Q == hex.Q && p.R == hex.R))
                return "#FFC107"; // Amber for path
        }
        
        // Normal mode highlight
        var isHighlighted = HighlightedHex != null && hex.Q == HighlightedHex.Q && hex.R == HighlightedHex.R;
        return isHighlighted ? "#4CAF50" : HexColor;
    }
}